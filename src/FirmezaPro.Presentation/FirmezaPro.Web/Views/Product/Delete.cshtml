@model FirmezaPro.Web.Models.Products.DeleteProductViewModel

@{
    ViewData["Title"] = "Eliminar Producto";
}

<h2 class="text-danger">¿Eliminar producto?</h2>

<div class="alert alert-warning">
    <strong>Esta acción no se puede deshacer.</strong>
</div>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Precio</dt>
    <dd class="col-sm-9">@Model.Price.ToString("C")</dd>

    <dt class="col-sm-3">Stock</dt>
    <dd class="col-sm-9">@Model.Stock</dd>

    <dt class="col-sm-3">Activo</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Sí" : "No")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Sí, eliminar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>