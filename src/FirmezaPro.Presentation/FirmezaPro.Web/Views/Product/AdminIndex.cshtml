@model FirmezaPro.Web.Models.Products.AdminProductListViewModel

@{
    ViewData["Title"] = "Panel de Productos - Admin";
}

<h2>@ViewData["Title"]</h2>

<form method="get" class="mb-3 d-flex gap-2">
    <input type="text"
           name="search"
           class="form-control"
           placeholder="Buscar producto..."
           value="@Model.Search" />

    <button type="submit" class="btn btn-outline-primary">
        Buscar
    </button>
</form>

<a class="btn btn-primary mb-3" asp-action="Create">Crear Nuevo Producto</a>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Nombre</th>
        <th>Descripción</th>
        <th>Precio</th>
        <th>Stock</th>
        <th>Activo</th>
        <th>Acciones</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var product in Model.Products)
    {
        <tr>
            <td>@product.Name</td>
            <td>@product.Description</td>
            <td>@product.Price.ToString("C")</td>
            <td>@product.Stock</td>
            <td>@(product.IsActive ? "Sí" : "No")</td>
            <td>
                <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@product.Id">Editar</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@product.Id">Eliminar</a>
            </td>
        </tr>
    }
    
    <div class="mt-3 d-flex gap-2 align-items-center">
        @if (Model.Page > 1)
        {
            <a class="btn btn-outline-secondary"
               href="?page=@(Model.Page - 1)&search=@Model.Search">
                ← Anterior
            </a>
        }

        <span>Página @Model.Page</span>

        @if (Model.HasNextPage)
        {
            <a class="btn btn-outline-secondary"
               href="?page=@(Model.Page + 1)&search=@Model.Search">
                Siguiente →
            </a>
        }
    </div>
    </tbody>
</table>

<div class="mt-3 d-flex gap-2 align-items-center">
    @if (Model.Page > 1)
    {
        <a class="btn btn-outline-secondary"
           href="?page=@(Model.Page - 1)&search=@Model.Search">
            ← Anterior
        </a>
    }

    <span>Página @Model.Page</span>

    @if (Model.HasNextPage)
    {
        <a class="btn btn-outline-secondary"
           href="?page=@(Model.Page + 1)&search=@Model.Search">
            Siguiente →
        </a>
    }
</div>
