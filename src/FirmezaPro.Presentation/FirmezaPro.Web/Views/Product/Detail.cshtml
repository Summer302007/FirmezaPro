@model FirmezaPro.Domain.Entities.Product

@{
    ViewData["Title"] = "Detalle del Producto";
}

<h2>@ViewData["Title"]</h2>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text"><strong>Descripción:</strong> @Model.Description</p>
        <p class="card-text"><strong>Precio:</strong> @Model.Price.ToString("C")</p>
        <p class="card-text"><strong>Stock:</strong> @Model.Stock</p>
        <p class="card-text"><strong>Activo:</strong> @(Model.IsActive ? "Sí" : "No")</p>
        <a asp-action="AdminIndex" class="btn btn-secondary">Volver</a>
    </div>
</div>